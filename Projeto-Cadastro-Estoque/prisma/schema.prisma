model Produto {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  nome           String
  categoria      String
  quantidade     Int
  unidade        String
  preco          Float
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  @@unique([nome, categoria]) // <- Isso evita duplicatas no banco
  movimentacoes  Movimentacao[]  @relation("ProdutoMovimentacoes")
  historicos     Historico[]     @relation("ProdutoHistoricos") // Definindo a relação com Historico
}

model Movimentacao {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  tipo       String   // "entrada" ou "saida"
  quantidade Int
  produtoId  String   @db.ObjectId
  produto    Produto  @relation("ProdutoMovimentacoes", fields: [produtoId], references: [id])
  data       DateTime @default(now())
}

model Historico {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  tipo       String   // Criação, Atualização, Exclusão
  descricao  String   // Detalhes da ação
  produtoId  String   @db.ObjectId
  produto    Produto  @relation("ProdutoHistoricos", fields: [produtoId], references: [id], onDelete: Cascade) // Relacionamento bidirecional
  createdAt  DateTime @default(now())
}
model Usuario {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  nome       String
  email      String   @unique
  senha      String
  createdAt  DateTime @default(now())  // Adicionando a data de criação
}
